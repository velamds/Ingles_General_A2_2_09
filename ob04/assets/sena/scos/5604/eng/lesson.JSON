{"_data": [{"contents": [{"content": "Vanessa Starts Dating Marco", "type": "lesson_name"}, {"content": "Talking to Sally", "type": "unit_name"}, {"content": 4, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 9, "type": "lesson"}, {"content": "A2.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Identify and describe plans for the organization of events.", "type": "primary"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_1"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_2"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_3"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_4"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_5"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_6"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_7"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": "Sentence Stress - Disbelief or Surprise", "type": "heading"}, {"content": "You use sentence stress on some words in a sentence. These are content words.", "type": "describer"}, {"content": "Content words are the key (important) words of a sentence.  You place emphasis on these words.", "type": "text"}, {"content": " If you want to express surprise or disbelief, the sound at the end of the sentence changes.", "type": "text"}, {"content": "You use rising intonation to tell the listener that you are surprised by what they just heard.", "type": "text"}, {"content": "<span class= \"italic\">Example: Wow, that's amazing!</span>", "type": "text"}, {"content": "You use falling intonation to express sarcasm or disbelief.", "type": "text"}, {"content": "<span class= \"italic\">Example: I don't believe that!</span>", "type": "text"}], "type": "learning_points"}, {"contents": [{"content": "big kid ", "type": "name"}, {"content": "to act in a child-like way ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: My boyfriend was acting like a big kid.", "type": "example"}, {"content": "engenn5le09ob04aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you hear when people talk about dating.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "flock ", "type": "name"}, {"content": "a group of birds or animals ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The flock of geese was moving towards us. ", "type": "example"}, {"content": "engenn5le09ob04aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to hiss ", "type": "name"}, {"content": "to make a noise which sounds like \"ssss\"  ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The geese made a hissing sound.", "type": "example"}, {"content": "engenn5le09ob04aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "vicious ", "type": "name"}, {"content": "very dangerous and violent ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The vicious animal made us nervous.", "type": "example"}, {"content": "engenn5le09ob04aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to amuse ", "type": "name"}, {"content": "to make someone laugh or smile ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I was not amused with his behavior.", "type": "example"}, {"content": "engenn5le09ob04aud05", "type": "audio"}], "type": "target_word"}, {"content": "engenn5le09ob04re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Write a 10-12 line dialogue about a date.", "type": "text"}, {"content": "Describe the location and what happened.", "type": "text"}, {"content": "Use 5 words that have different <span class=\"italic\">o</span> sounds.", "type": "text"}, {"content": "Read the dialogue aloud to a partner or family member.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I write about a date.", "type": "text"}, {"content": "I say and use words with <span class=\"italic\">o</span> sounds in conversations.", "type": "text"}, {"content": "I read my dialogue aloud to a partner or family member.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn5le09ob04re2img05.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn5le09ob04re2img05.jpg", "time": "100", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: Hey, Sally.<br>\n<span class=\"strong\">Sally</span>: Hi, how was your walk through the park with Marco?<br>\n<span class=\"strong\">Vanessa</span>: The weather was nice.  There were lots of kids in the playground.<br>\n<span class=\"strong\">Sally</span>: That doesn't sound too romantic ...<br>"}, {"image": "engenn5le09ob04re2img05.jpg", "time": "11500", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: I think Marco might be a big kid himself. He wanted to play on the swings.<br>\n<span class=\"strong\">Sally</span>: I don't believe it.  He seems too cool for that.<br>\n<span class=\"strong\">Vanessa</span>: There was a bit of an incident at the pond though ... geese everywhere.<br>"}, {"image": "engenn5le09ob04re2img01.jpg", "time": "24800", "id": 3, "text": "<span class=\"strong\">Sally</span>: What do you mean?<br>\n<span class=\"strong\">Vanessa</span>: Marco thought it would be funny to put his arms around my waist and make me face an incoming flock of hissing birds.<br>\n<span class=\"strong\">Sally</span>: Huh ... he wouldn't let you go? They can be vicious.<br>\n<span class=\"strong\">Vanessa</span>: I was not amused."}, {"image": "engenn5le09ob04re2img05.jpg", "time": "40800", "id": 4, "text": "<span class=\"strong\">Sally</span>: Well, you know what guys can be like sometimes.  Give him a chance.<br>\n<span class=\"strong\">Vanessa</span>: Hmm ... alright. He bought me flowers.<br>\n<span class=\"strong\">Sally</span>: Around the waist, huh?<br>\n<span class=\"strong\">Vanessa</span>: Nothing happened, Sally."}], "audiosrc": "engenn5le09ob04re2aud01", "coverimg": "engenn5le09ob04re2img05.jpg"}, "type": "slideshow"}], "id": 1}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": "I can say and compare words with the <span class=\"italic\">o</span> sound.", "type": "Learning Outcomes"}, {"content": "I can use appropriate sentence stress. ", "type": "Learning Outcomes"}, {"cont
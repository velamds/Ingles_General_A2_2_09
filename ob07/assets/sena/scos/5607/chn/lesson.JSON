h?"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "humble abode"}, {"type": "definition", "content": "used to refer to someone's home"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Welcome to my humble abode. "}, {"type": "audio", "content": "engenn5le09ob07aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about different objects in rooms."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "lamp"}, {"type": "definition", "content": "an object that produces light by using electricity"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: That's a nice lamp on the table over there."}, {"type": "audio", "content": "engenn5le09ob07aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "armchair"}, {"type": "definition", "content": "a comfortable chair with sides that you can rest your arms on"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: This armchair is so comfortable. "}, {"type": "audio", "content": "engenn5le09ob07aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "housewarming"}, {"type": "definition", "content": "a party to celebrate after moving into a new home"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I went to a housewarming party yesterday. "}, {"type": "audio", "content": "engenn5le09ob07aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "mug"}, {"type": "definition", "content": "a tall cup used for drinking liquids"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I have many mugs in my cupboard."}, {"type": "audio", "content": "engenn5le09ob07aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "hand-painted"}, {"type": "definition", "content": "painted by a person rather than a machine "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: This design was hand-painted by an artist."}, {"type": "audio", "content": "engenn5le09ob07aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "cutlery"}, {"type": "definition", "content": "knives, forks, and spoons that you use for eating food "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I collect cutlery. Look in that drawer."}, {"type": "audio", "content": "engenn5le09ob07aud07"}]}, {"type": "background_image", "content": "engenn5le09ob07re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Pretend that you are in your bedroom. Suddenly, the walls of your room start to talk. What do they say? What do you say?"}, {"type": "text", "content": "Write a short story about what happens. Use the Simple Past tense."}, {"type": "text", "content": "Proofread your story. Read it aloud to a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write about objects in my bedroom."}, {"type": "text", "content": "I write about an event in the past."}, {"type": "text", "content": "I tell a story."}]}], "labs": [{"stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "contents": [{}], "id": 0}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn5le09ob07re2aud01", "coverimg": "engenn5le09ob07re2img01.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn5le09ob07re2img01.jpg"}, {"text": "<span class=\"strong\">Marco</span>: Welcome to my humble abode. <br>\n<span class=\"strong\">Vanessa</span>: This is nice. That's a cool lamp and armchair!<br>\n<span class=\"strong\">Marco</span>: Thanks.The lamp's from my sister.<br>\n<span class=\"strong\">Vanessa</span>: You have a sister?<br>\n<span c
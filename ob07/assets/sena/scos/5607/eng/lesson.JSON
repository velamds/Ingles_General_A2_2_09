ows\":8,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Show Surprise\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Show Interest \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Oh?</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Wow!</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Oh yeah?</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">No!</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Really?</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Oh boy!</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Oh, really?</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Amazing!</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Is that right?</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">That's unbelievable!</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">What happened? </span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Get out of here!</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">No way!</span> \\\"}\",\"\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "<span class=\"strong\">Chelsea</span>: My sister found it in a shop.<br> <span class=\"strong\">Tom</span>: Oh yeah?", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "humble abode", "type": "name"}, {"content": "used to refer to someone's home", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Welcome to my humble abode. ", "type": "example"}, {"content": "engenn5le09ob07aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about different objects in rooms.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "lamp", "type": "name"}, {"content": "an object that produces light by using electricity", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: That's a nice lamp on the table over there.", "type": "example"}, {"content": "engenn5le09ob07aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "armchair", "type": "name"}, {"content": "a comfortable chair with sides that you can rest your arms on", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: This armchair is so comfortable. ", "type": "example"}, {"content": "engenn5le09ob07aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "housewarming", "type": "name"}, {"content": "a party to celebrate after moving into a new home", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I went to a housewarming party yesterday. ", "type": "example"}, {"content": "engenn5le09ob07aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "mug", "type": "name"}, {"content": "a tall cup used for drinking liquids", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I have many mugs in my cupboard.", "type": "example"}, {"content": "engenn5le09ob07aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "hand-painted", "type": "name"}, {"content": "painted by a person rather than a machine ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: This design was hand-painted by an artist.", "type": "example"}, {"content": "engenn5le09ob07aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "cutlery", "type": "name"}, {"content": "knives, forks, and spoons that you use for eating food ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I collect cutlery. Look in that drawer.", "type": "example"}, {"content": "engenn5le09ob07aud07", "type": "audio"}]}, {"content": "engenn5le09ob07re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Pretend that you are in your bedroom. Suddenly, the walls of your room start to talk. What do they say? What do you say?", "type": "text"}, {"content": "Write a short story about what happens. Use the Simple Past tense.", "type": "text"}, {"content": "Proofread your story. Read it aloud to a partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write about objects in my bedroom.", "type": "text"}, {"content": "I write about an event in the past.", "type": "text"}, {"content": "I tell a story.", "type": "text"}]}]}
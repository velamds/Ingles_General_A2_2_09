 0, "id": 1}]}], "stimuli_ids": [], "id": 9, "type": "GIW", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " William talks about what happened."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "post_instructions", "contents": [{"type": "text", "content": " Instructions: <span class=\"bullet\">Proofread the sentence.</span> <span class=\"bullet\">Click on the incorrect word.</span><span class=\"bullet\">Type in the correct word to complete the sentence.</span> <span class=\"bullet\">Use capital letters where necessary.</span>"}]}], "template_override": 1}, {"questions": [{"_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}], "id": 0, "responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 1}]}], "stimuli_ids": [], "id": 10, "type": "RSLT", "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}], "template_override": 1}, {"questions": [{"_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn5le09ob10re7pdf01.pdf"}]}], "id": 0, "responses": [{"correct": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}]}], "stimuli_ids": [], "id": 11, "type": "DWS", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " You are going to write about your birthday!"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}, {"type": "skill", "content": "Listening"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}]}], "template_override": 1}], "id": 0, "type": "scholar", "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "id": 0, "contents": [{}]}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn5le09ob10re2aud01", "coverimg": "engenn5le09ob10re2img05.jpg", "images": [{"text": "", "id": 0, "time": "", "image": "engenn5le09ob10re2img05.jpg"}, {"text": "<span class =\"strong\">Sally</span>: How are you? How's Marco?<br />\n<span class =\"strong\">Vanessa</span>: I'm good. He's great! We have lots to catch up on! You won't believe what happened!<br />\n<span class =\"strong\">Sally</span>: What happened?<br />\n<span class =\"strong\">Vanessa</span>: So, I was painting my nails, when I heard the doorbell.<br />\n<span class =\"strong\">Sally</span>: Okay ... <br />\n<span class =\"strong\">Vanessa</span>: I went to see who it was. I wasn't expecting anyone.", "id": 1, "time": "100", "image": "engenn5le09ob10re2img05.jpg"}, {"text": "<span class =\"strong\">Sally</span>: Let me guess, it was Marco?<br />\n<span class =\"strong\">Vanessa</span>: How did you know, Sally?<br />\n<span class =\"strong\">Sally</span>: Just a lucky guess.<br />\n<span class =\"strong\">Vanessa</span>: I was surprised to see him. I gave him a call earlier, now I know why. He had a surprise for me. <br />\n<span class =\"strong\">Sally</span>: Oh?<br />\n<span class =\"strong\">Vanessa</span>: He cooked and brought dinner over for me.", "id": 2, "time": "20300", "image": "engenn5le09ob10re2img06.jpg"}, {"text": "<span class =\"strong\">Sally</span>: Cute! What did he make you?<br />\n<span class =\"strong\">Vanessa</span>: Veal marsala.<br />\n<span class =\"strong\">Sally</span>: Fancy. Were you guys gazing into each other's eyes as you talked?<br />\n<span class =\"strong\">Vanessa</span>: Oh Sally. He looked really nervous. I thought it was kind of cute. <br />\n<span class =\"strong\">Sally</span>: I think watching penguins while they waddle is cute. I read a book about them. <br />\n<span class =\"strong\">Vanessa</span>: Sally, you always spoil the mood.", "id": 3, "time": "39000", "image": "engenn5le09ob10re2img05.jpg"}]}}]}, {"id": 3, "type": "text", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "audio", "value": "engenn5le09ob10re6aud01"}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Vanessa Starts Dating Marco"}, {"type": "unit_name", "content": "A Pleasant Evening"}, {"type": "position", "content": 10}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 9}, {"type": "level", "content": "A2.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": " Describe characteristics of different people and their jobs."}, {"type": "secondary_1", "content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}, {"type": "secondary_2", "content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}, {"type": "secondary_3", "content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}, {"type": "secondary_4", "content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}, {"type": "secondary_5", "content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}, {"type": "secondary_6", "content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}, {"type": "secondary_7", "content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}, {"type": "secondary_8", "content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. "}]}, {"type": "background_image", "content": "engenn5le09ob10re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Past & Past Continuous Tense "}, {"type": "describer", "content": "You use the Past Continuous tense to talk about something that was happening at a particular time in the past."}, {"type": "text", "content": "<span class=\"italic\">Form: subject + was/were + verb-ing </span>"}, {"type": "text", "content": " You can use the Past Continuous tense together with the Simple Past tense."}, {"type": "text", "content": "The Past Continuous talks about a longer \u2018background' action. The Simple Past talks about a shorter event that happened in the middle of, or interrupted, the longer event."}, {"type": "text", "content": "You use the words <span class =\"strong\">when</span>, <span class =\"strong\">while</span> and <span class =\"strong\">as</span>."}, {"type": "example", "content": "She was studying for her test <span class =\"strong\">when</span> I called her."}, {"type": "example", "content": "<span class =\"strong\">While</span> I was opening the cupboard, I heard a loud crash."}, {"type": "example", "content": "<span class =\"strong\">As</span> I was walking, the bird flew by."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to catch up"}, {"type": "definition", "content": "to talk to someone and find out what they have been doing"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: We need to catch up soon!"}, {"type": "audio", "content": "engenn5le09ob10aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use to talk about free activities. "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to paint your nails"}, {"type": "definition", "content": "to put color on your fingernails"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I was painting my nails."}, {"type": "audio", "content": "engenn5le09ob10aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to bring over"}, {"type": "definition", "content": "to take something from one place to another place where someone else is, especially their home"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I'll bring over a pizza to your place tonight."}, {"type": "audio", "content": "engenn5le09ob10aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to gaze"}, {"type": "definition", "content": "to look at someone or something for a long time"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Did he gaze into your eyes?"}, {"type": "audio", "content": "engenn5le09ob10aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "each other"}, {"type": "definition", "content": "used to show that one person does something with the other "}, {"type": "part_speech", "content": "(pronoun)"}, {"type": "example", "content": "Example: Did you talk to each other?"}, {"type": "audio", "content": "engenn5le09ob10aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "mood"}, {"type": "definition", "content": "the way you feel about something"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: You always ruin my happy mood."}, {"type": "audio", "content": "engenn5le09ob10aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "give a call"}, {"type": "definition", "content": "to call someone using the telephone"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: I'll give you a call when I have time."}, {"type": "audio", "content": "engenn5le09ob10aud07"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Think of your last birthday. What did you do?"}, {"type": "text", "content": "Write a short summary (7-8 sentences) about this event."}, {"type": "text", "content": "Proofread your summary."}, {"type": "text", "content": "Read it aloud to your partner."}, {"type": "text", "content": "Listen to their summary."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write about an event in the past. "}, {"type": "text", "content": "I talk about what I was doing when something else happened."}, {"type": "text", "content": "I talk about events in the past."}]}], "type": "sena"}